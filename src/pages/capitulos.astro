---
// src/pages/capitulos.astro
// Página-Índice de Capítulos — Projeto Mário Holanda
// Responsabilidade: Apresentar a narrativa das histórias e marcos da trajetória
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Capítulos — Mário Holanda"
  description="Histórias, momentos e marcos de uma trajetória construída um capítulo de cada vez."
>
  <section class="page-section" aria-labelledby="page-title">
    <div class="container-reading content-container">
      <header class="section-header">
        <p class="page-eyebrow">História e Trajetória</p>
        <h1 id="page-title" class="page-title">Capítulos</h1>
        <p class="page-concept">Cada história vivida, um passo na caminhada.</p>
      </header>

      <div class="narrative-body">
        <p>
          Esta área é dedicada ao relato autêntico da minha caminhada. Aqui, acontecimentos,
          desafios superados, conquistas e momentos de transformação serão contados como
          capítulos de um livro aberto.
        </p>
        <p>
          As histórias não precisam seguir uma ordem cronológica rígida; cada relato traz
          consigo a memória e o aprendizado daquele momento.
        </p>
      </div>

      <div class="construction-note">
        <p class="note-title">Capítulos em elaboração</p>
        <p class="note-text">
          Os primeiros textos e histórias estão sendo cuidadosamente escritos e estruturados.
          Em breve, novos capítulos serão publicados aqui.
        </p>
        <p class="note-quote">
          <em>"O livro não precisa estar terminado para começar a ser lido."</em>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-9);
    min-height: 50vh;
  }

  .content-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .page-eyebrow {
    font-family: var(--font-body);
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .page-title {
    font-family: var(--font-headings);
    font-size: var(--font-size-h1);
    line-height: var(--line-height-h1);
    color: var(--color-primary);
    font-weight: 700;
  }

  .page-concept {
    font-family: var(--font-headings);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    color: var(--color-secondary);
    font-weight: 700;
  }

  .narrative-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: var(--color-text);
  }

  .narrative-body p {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    max-width: 65ch;
  }

  .construction-note {
    margin-top: var(--space-4);
    padding: var(--space-5);
    background-color: var(--color-white);
    border-left: 3px solid var(--color-secondary);
    border-radius: 0 var(--space-1) var(--space-1) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .note-title {
    font-family: var(--font-headings);
    font-size: var(--font-size-body);
    font-weight: 700;
    color: var(--color-primary);
  }

  .note-text {
    font-family: var(--font-body);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    color: var(--color-text);
  }

  .note-quote {
    margin-top: var(--space-2);
    font-family: var(--font-headings);
    font-size: var(--font-size-small);
    color: var(--color-secondary);
  }

  @media (max-width: 767px) {
    .page-section {
      padding-top: var(--space-6);
      padding-bottom: var(--space-6);
    }
  }
</style>
