---
// src/pages/capitulos.astro
// Página-Índice de Capítulos — Projeto Mário Holanda
// Responsabilidade: Apresentar a narrativa das histórias e marcos da trajetória
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Capítulos — Mário Holanda"
  description="Histórias, momentos e marcos de uma trajetória construída um capítulo de cada vez."
>
  <section class="page-section" aria-labelledby="page-title">
    <div class="container-reading content-container">
      <header class="section-header">
        <p class="page-eyebrow">História e Trajetória</p>
        <h1 id="page-title" class="page-title">Capítulos</h1>
        <p class="page-concept">Cada história vivida, um passo na caminhada.</p>
      </header>

      <div class="narrative-body">
        <p>
          Esta área é dedicada ao relato autêntico da minha caminhada. Aqui, acontecimentos,
          desafios superados, conquistas e momentos de transformação serão contados como
          capítulos de um livro aberto.
        </p>
        <p>
          As histórias não precisam seguir uma ordem cronológica rígida; cada relato traz
          consigo a memória e o aprendizado daquele momento.
        </p>
      </div>

      <section class="chapters-list" aria-label="Capítulos publicados">
        <article class="chapter-card">
          <p class="chapter-number">Capítulo 1</p>

          <h2 class="chapter-title">O começo</h2>

          <p class="chapter-date">21 de agosto de 2026</p>

          <p class="chapter-description">
            Uma história sobre a vontade de aprender, as imperfeições do caminho
            e a decisão de começar a construir algo novo.
          </p>

          <a href="/capitulos/01-o-comeco" class="chapter-link">
            Ler capítulo →
          </a>
        </article>
      </section>

      <div class="construction-note">
        <p class="note-title">A história continua</p>
        <p class="note-text">
          Este é apenas o primeiro capítulo. Novas histórias, lembranças e momentos
          continuarão sendo registrados ao longo da caminhada.
        </p>
        <p class="note-quote">
          <em>"O livro não precisa estar terminado para começar a ser lido."</em>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-9);
    min-height: 50vh;
  }

  .content-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .page-eyebrow,
  .chapter-number {
    font-family: var(--font-body);
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .page-title {
    font-family: var(--font-headings);
    font-size: var(--font-size-h1);
    line-height: var(--line-height-h1);
    color: var(--color-primary);
    font-weight: 700;
  }

  .page-concept {
    font-family: var(--font-headings);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    color: var(--color-secondary);
    font-weight: 700;
  }

  .narrative-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: var(--color-text);
  }

  .narrative-body p {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    max-width: 65ch;
  }

  .chapters-list {
    display: flex;
    flex-direction: column;
  }

  .chapter-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid rgba(11, 31, 58, 0.1);
    border-radius: var(--space-1);
  }

  .chapter-title {
    font-family: var(--font-headings);
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    color: var(--color-primary);
    font-weight: 700;
  }

  .chapter-date {
    font-family: var(--font-body);
    font-size: var(--font-size-small);
    color: var(--color-text);
    opacity: 0.7;
  }

  .chapter-description {
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-text);
    max-width: 60ch;
  }

  .chapter-link {
    font-family: var(--font-body);
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--color-secondary);
    text-decoration: none;
  }

  .chapter-link:hover {
    text-decoration: underline;
  }

  .chapter-link:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 3px;
  }

  .construction-note {
    margin-top: var(--space-4);
    padding: var(--space-5);
    background-color: var(--color-white);
    border-left: 3px solid var(--color-secondary);
    border-radius: 0 var(--space-1) var(--space-1) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .note-title {
    font-family: var(--font-headings);
    font-size: var(--font-size-body);
    font-weight: 700;
    color: var(--color-primary);
  }

  .note-text {
    font-family: var(--font-body);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    color: var(--color-text);
  }

  .note-quote {
    margin-top: var(--space-2);
    font-family: var(--font-headings);
    font-size: var(--font-size-small);
    color: var(--color-secondary);
  }

  @media (max-width: 767px) {
    .page-section {
      padding-top: var(--space-6);
      padding-bottom: var(--space-6);
    }

    .chapter-card {
      padding: var(--space-5);
    }
  }
</style>
