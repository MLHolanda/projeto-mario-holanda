---
// src/pages/contato.astro
// Página-Índice de Contato — Projeto Mário Holanda
// Responsabilidade: Apresentar caminhos conceituais e humanos de diálogo e conexão
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contato — Mário Holanda"
  description="Caminhos de diálogo, troca de ideias e conexão humana."
>
  <section class="page-section" aria-labelledby="page-title">
    <div class="container-reading content-container">
      <header class="section-header">
        <p class="page-eyebrow">Conexão e Diálogo</p>
        <h1 id="page-title" class="page-title">Contato</h1>
        <p class="page-concept">Pontes para conversas, parcerias e troca de experiências.</p>
      </header>

      <div class="narrative-body">
        <p>
          O contato representa a abertura para o diálogo humano, a escuta e a conexão
          verdadeira. Seja para trocar ideias sobre tecnologia e inteligência artificial,
          conversar sobre projetos ou compartilhar reflexões, este espaço é um convite
          à proximidade.
        </p>
        <p>
          Acreditamos em conversas que agregam valor e respeitam o tempo e a privacidade
          de cada pessoa.
        </p>
      </div>

      <div class="contact-channels">
        <div class="channel-card">
          <h2 class="channel-title">Interação Direta</h2>
          <p class="channel-description">
            Os canais formais e diretos de comunicação estão sendo definidos para proporcionar
            uma experiência de contato simples, acessível e segura, sem intermediários desnecessários
            ou coleta invasiva de dados.
          </p>
        </div>
      </div>

      <div class="construction-note">
        <p class="note-title">Canais em estruturação</p>
        <p class="note-text">
          As formas de conexão direta e redes de contato serão disponibilizadas de forma
          clara e transparente nos próximos passos do projeto.
        </p>
        <p class="note-quote">
          <em>"Um Capítulo de Cada Vez."</em>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-9);
    min-height: 50vh;
  }

  .content-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .page-eyebrow {
    font-family: var(--font-body);
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .page-title {
    font-family: var(--font-headings);
    font-size: var(--font-size-h1);
    line-height: var(--line-height-h1);
    color: var(--color-primary);
    font-weight: 700;
  }

  .page-concept {
    font-family: var(--font-headings);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    color: var(--color-secondary);
    font-weight: 700;
  }

  .narrative-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: var(--color-text);
  }

  .narrative-body p {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    max-width: 65ch;
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .channel-card {
    padding: var(--space-5);
    background-color: var(--color-white);
    border-radius: var(--space-1);
    border: 1px solid rgba(11, 31, 58, 0.08);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .channel-title {
    font-family: var(--font-headings);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    color: var(--color-primary);
  }

  .channel-description {
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-text);
  }

  .construction-note {
    margin-top: var(--space-2);
    padding: var(--space-5);
    background-color: var(--color-white);
    border-left: 3px solid var(--color-secondary);
    border-radius: 0 var(--space-1) var(--space-1) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .note-title {
    font-family: var(--font-headings);
    font-size: var(--font-size-body);
    font-weight: 700;
    color: var(--color-primary);
  }

  .note-text {
    font-family: var(--font-body);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    color: var(--color-text);
  }

  .note-quote {
    margin-top: var(--space-2);
    font-family: var(--font-headings);
    font-size: var(--font-size-small);
    color: var(--color-secondary);
  }

  @media (max-width: 767px) {
    .page-section {
      padding-top: var(--space-6);
      padding-bottom: var(--space-6);
    }
  }
</style>
