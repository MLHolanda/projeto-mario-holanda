---
// src/pages/index.astro
// Página Inicial — Entrada da Experiência do Projeto Mário Holanda
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';

const journeyPaths = [
  {
    href: '/capitulos',
    eyebrow: 'História e Trajetória',
    title: 'Capítulos',
    description:
      'Histórias, momentos e experiências que ajudam a contar uma trajetória em constante construção.',
  },
  {
    href: '/projetos',
    eyebrow: 'Criação e Prática',
    title: 'Projetos',
    description:
      'Construções que refletem aprendizados, experiências e diferentes momentos da jornada.',
  },
  {
    href: '/aprendizados',
    eyebrow: 'Conhecimento em Construção',
    title: 'Aprendizados',
    description:
      'Estudos, descobertas, ferramentas e conhecimentos que continuam evoluindo a cada passo.',
  },
  {
    href: '/pensamentos',
    eyebrow: 'Reflexões e Ideias',
    title: 'Pensamentos',
    description:
      'Percepções, perguntas e ideias que ainda estão encontrando seu próprio caminho.',
  },
  {
    href: '/contato',
    eyebrow: 'Conexão e Diálogo',
    title: 'Contato',
    description:
      'Um espaço aberto para conversas, trocas de experiências e novas possibilidades.',
  },
];
---

<BaseLayout
  title="Mário Holanda — Um Capítulo de Cada Vez"
  description="Prazer, eu sou o Mário. Esta é a minha jornada — uma experiência digital viva, autêntica e contínua."
>
  <section class="hero-entry" aria-labelledby="hero-title">
    <div class="container-reading hero-container">
      <div class="hero-brand-mark">
        <Logo width={96} height={64} class="hero-logo" />
      </div>

      <header class="hero-header">
        <p class="hero-eyebrow">Boas-vindas à minha jornada</p>
        <h1 id="hero-title" class="hero-title">Prazer, eu sou o Mário.</h1>
        <p class="hero-concept">Esta é a minha história — um capítulo de cada vez.</p>
      </header>

      <div class="hero-narrative">
        <p>
          Este espaço não é um portfólio tradicional de certezas ou conquistas prontas. É o registro
          vivo e autêntico de uma caminhada — feita de curiosidade, aprendizados, tentativas,
          projetos e recomeços.
        </p>
        <p>
          Aqui, cada etapa é construída de forma consciente, compartilhada e humana. Trago minhas
          ideias, experiências, vontades e imperfeições; a inteligência artificial caminha ao meu
          lado, ajudando a organizar pensamentos, aprender e construir.
        </p>
        <p class="hero-motto">
          <em>"O livro não precisa estar terminado para começar a ser lido."</em>
        </p>
      </div>
    </div>
  </section>

  <section class="journey-paths" aria-labelledby="journey-title">
    <div class="container-wide journey-container">
      <div class="journey-introduction">
        <p class="section-eyebrow">Caminhos da jornada</p>
        <h2 id="journey-title" class="journey-title">
          Escolha por onde continuar.
        </h2>
        <p class="journey-text">
          Cada caminho revela uma parte diferente desta história. Não existe uma ordem
          obrigatória. Você pode começar por onde fizer mais sentido para você.
        </p>
      </div>

      <nav class="journey-navigation" aria-label="Caminhos da jornada">
        <ul class="journey-list">
          {journeyPaths.map((path) => (
            <li class="journey-item">
              <a href={path.href} class="journey-link">
                <p class="journey-eyebrow">{path.eyebrow}</p>
                <h3 class="journey-item-title">{path.title}</h3>
                <p class="journey-description">{path.description}</p>
                <span class="journey-action">Continuar →</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-entry {
    display: flex;
    align-items: center;
    min-height: 52vh;
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .hero-brand-mark {
    display: flex;
    align-items: center;
  }

  .hero-logo {
    filter: drop-shadow(0 2px 8px rgba(11, 31, 58, 0.06));
  }

  .hero-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .hero-eyebrow,
  .section-eyebrow,
  .journey-eyebrow {
    font-family: var(--font-body);
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-title {
    font-family: var(--font-headings);
    font-size: var(--font-size-h1);
    line-height: var(--line-height-h1);
    color: var(--color-primary);
    font-weight: 700;
  }

  .hero-concept {
    font-family: var(--font-headings);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    color: var(--color-secondary);
    font-weight: 700;
  }

  .hero-narrative,
  .journey-text,
  .journey-description {
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-text);
  }

  .hero-narrative {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 65ch;
  }

  .hero-motto {
    margin-top: var(--space-2);
    font-family: var(--font-headings);
    font-size: var(--font-size-small);
    color: var(--color-secondary);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
  }

  .journey-paths {
    padding-top: var(--space-9);
    padding-bottom: var(--space-9);
    border-top: 1px solid rgba(11, 31, 58, 0.08);
  }

  .journey-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .journey-introduction {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 60ch;
  }

  .journey-title {
    font-family: var(--font-headings);
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    color: var(--color-primary);
    font-weight: 700;
  }

  .journey-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journey-item:last-child {
    grid-column: 1 / -1;
  }

  .journey-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 100%;
    padding: var(--space-6);
    color: inherit;
    text-decoration: none;
    background-color: var(--color-white);
    border: 1px solid rgba(11, 31, 58, 0.1);
    border-radius: var(--space-1);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .journey-link:hover {
    background-color: rgba(15, 118, 110, 0.03);
    border-color: var(--color-secondary);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(11, 31, 58, 0.05);
  }

  .journey-link:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 3px;
  }

  .journey-item-title {
    font-family: var(--font-headings);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    color: var(--color-primary);
    font-weight: 700;
  }

  .journey-action {
    margin-top: auto;
    font-family: var(--font-body);
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--color-secondary);
  }

  @media (max-width: 767px) {
    .hero-entry,
    .journey-paths {
      padding-top: var(--space-6);
      padding-bottom: var(--space-6);
    }

    .hero-entry {
      min-height: auto;
    }

    .hero-container {
      gap: var(--space-4);
    }

    .journey-list {
      grid-template-columns: 1fr;
    }

    .journey-item:last-child {
      grid-column: auto;
    }

    .journey-link {
      padding: var(--space-5);
    }
  }
</style>
