---
// src/components/Header.astro
// Componente de Cabeçalho do Projeto Mário Holanda
// Responsabilidade exclusiva: Landmark semântico <header>
import Navigation from './Navigation.astro';
---

<header class="site-header">
  <div class="container-wide header-container">
    <div class="header-brand">
      <a href="/" class="brand-link">
        <span class="brand-name">Mário Holanda</span>
        <span class="brand-concept">Um Capítulo de Cada Vez</span>
      </a>
    </div>
    <Navigation />
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    background-color: var(--color-background);
    border-bottom: 1px solid rgba(11, 31, 58, 0.08); /* Delimitação sutil */
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .header-brand {
    display: flex;
    align-items: center;
  }

  .brand-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-primary);
  }

  .brand-link:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 4px;
    border-radius: var(--space-1);
  }

  .brand-name {
    font-family: var(--font-headings);
    font-size: var(--font-size-h3);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-primary);
  }

  .brand-concept {
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    color: var(--color-secondary);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  @media (max-width: 767px) {
    .header-container {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-3);
    }

    .brand-link {
      align-items: center;
    }
  }
</style>
