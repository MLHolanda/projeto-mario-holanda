---
// src/components/Header.astro
// Componente de Cabeçalho do Projeto Mário Holanda
// Responsabilidade exclusiva: Landmark semântico <header>
import Navigation from './Navigation.astro';
import Logo from './Logo.astro';
---

<header class="site-header">
  <div class="container-wide header-container">
    <div class="header-brand">
      <a href="/" class="brand-link" aria-label="Mário Holanda — Página Inicial">
        <Logo width={54} height={36} class="header-logo" />
        <div class="brand-text">
          <span class="brand-name">Mário Holanda</span>
          <span class="brand-concept">Um Capítulo de Cada Vez</span>
        </div>
      </a>
    </div>
    <Navigation />
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    background-color: var(--color-background);
    border-bottom: 1px solid rgba(11, 31, 58, 0.08); /* Delimitação sutil */
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .header-brand {
    display: flex;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-primary);
    border-radius: var(--space-1);
    transition: opacity 0.2s ease;
  }

  .brand-link:hover {
    opacity: 0.9;
  }

  .brand-link:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 4px;
  }

  .header-logo {
    transition: transform 0.2s ease;
  }

  .brand-link:hover .header-logo {
    transform: scale(1.04);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-headings);
    font-size: var(--font-size-h3);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-primary);
  }

  .brand-concept {
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    color: var(--color-secondary);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  @media (max-width: 767px) {
    .header-container {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-3);
    }

    .brand-link {
      justify-content: center;
    }

    .brand-text {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
