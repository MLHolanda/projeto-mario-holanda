---
// src/components/Navigation.astro
// Componente de Navegação Principal do Projeto Mário Holanda
// Responsabilidade exclusiva: Landmark semântico <nav>

const pathname = Astro.url.pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';

const navItems = [
  { href: '/', label: 'Início' },
  { href: '/capitulos', label: 'Capítulos' },
  { href: '/projetos', label: 'Projetos' },
  { href: '/aprendizados', label: 'Aprendizados' },
  { href: '/pensamentos', label: 'Pensamentos' },
  { href: '/contato', label: 'Contato' },
];
---

<nav class="main-nav" aria-label="Navegação principal">
  <ul class="nav-list">
    {navItems.map((item) => {
      const isActive =
        item.href === '/'
          ? currentPath === '/'
          : currentPath.startsWith(item.href);

      return (
        <li class="nav-item">
          <a
            href={item.href}
            class:list={['nav-link', { 'is-active': isActive }]}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .main-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-item {
    display: flex;
    align-items: center;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-body);
    font-size: var(--font-size-small);
    font-weight: 500;
    color: var(--color-primary);
    text-decoration: none;
    border-radius: var(--space-1);
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-secondary);
    background-color: rgba(15, 118, 110, 0.08);
  }

  .nav-link.is-active {
    color: var(--color-primary);
    font-weight: 600;
    border-bottom: 2px solid var(--color-secondary);
    border-radius: 0;
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 2px;
  }

  @media (max-width: 767px) {
    .main-nav {
      width: 100%;
      justify-content: center;
    }

    .nav-list {
      justify-content: center;
      gap: var(--space-1) var(--space-2);
    }

    .nav-link {
      padding: var(--space-2);
    }
  }
</style>
